# Required — get your API key from your Zernio dashboard (https://zernio.com)
ZERNIO_API_KEY=

# Optional — defaults to https://zernio.com/api
# ZERNIO_API_URL=

# Optional — set to 'true' to enable the WhatsApp Business Calling dial pad
# NEXT_PUBLIC_WHATSAPP_CALLING_ENABLED=

# Required for the Apps directory and Composio OAuth connections
# Keep this value unchanged across redeploys so existing connections remain available.
COMPOSIO_API_KEY=
# Optional — defaults to https://backend.composio.dev/api
# COMPOSIO_API_URL=

# Required for private client invite sessions. Keep this value unchanged across redeploys.
BOOKLY_INVITE_SECRET=
BOOKLY_ADMIN_SECRET=

# NVIDIA inference used by the meeting bot
NVIDIA_API_KEY=
# Optional — defaults to the NVIDIA hosted chat completions endpoint
# NVIDIA_API_URL=
# Optional — defaults to minimaxai/minimax-m3
# NVIDIA_MODEL=
# Optional — MiniMax thinking mode; enabled gives the bot deeper tool-use reasoning
# NVIDIA_THINKING_MODE=enabled
# Optional — defaults to 1200
# NVIDIA_MAX_TOKENS=

# Optional HMAC secret for validating Zernio inbound webhooks
# ZERNIO_WEBHOOK_SECRET=
